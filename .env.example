# Copy this file to .env and modify the values as needed
# The .env file is already included in .gitignore for security

# =============================================================================
# LLM Configuration
# =============================================================================
# Choose your LLM provider and URL
# Options:
# - LM Studio: http://host.docker.internal:1234/v1
# - Ollama: http://host.docker.internal:11434
# - Docker: http://host.docker.internal:12434
LLM_API_URL=http://host.docker.internal:1234/v1

# =============================================================================
# Model Configuration
# =============================================================================
# Single model configuration (required)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional Hugging Face access token for faster, higher-rate model downloads.
# Leave blank for unauthenticated downloads.
HF_TOKEN=

# Device to run models on (cpu/cuda/mps)
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# =============================================================================
# Agent Configuration
# =============================================================================
# Token budget for agent operations
DEFAULT_TOKEN_BUDGET=8192

# Upper bound for the editable per-run replans setting
REPLANS_LIMIT=10

# Character limits for various inputs
MAX_CUSTOM_INSTRUCTIONS_CHARS=2000
MAX_SYSTEM_ROLE_CHARS=500
MAX_TOOL_INSTRUCTION_CHARS=500

# Intent agent configuration
INTENT_AGENT_MAX_ITERATIONS=1

# Coverage-based iteration limits
MAX_ITERATIONS_SUFFICIENT_COVERAGE=2
MAX_ITERATIONS_PROBABLY_SUFFICIENT_COVERAGE=4

# Web search iteration bonus
WEB_SEARCH_ITERATION_BONUS=2

# =============================================================================
# Docling PDF Processing Configuration
# =============================================================================
# OCR settings - set to True if processing scanned PDFs
DOCLING_DO_OCR=False

# Table structure recognition
DOCLING_DO_TABLE_STRUCTURE=True

# Table processing mode: ACCURATE (slower) or FAST (faster)
DOCLING_TABLE_MODE=FAST

# Force full page OCR - keep False for digital PDFs to avoid noise
DOCLING_FORCE_FULL_PAGE_OCR=False

# Formula enrichment - enable if PDFs contain mathematical formulas
DOCLING_DO_FORMULA_ENRICHMENT=False

# =============================================================================
# Weaviate Configuration
# =============================================================================
# Hybrid search blend (0.0=pure vector, 1.0=pure keyword)
WEAVIATE_HYBRID_ALPHA=0.7

# Weaviate default max results when query limit is not explicitly set
QUERY_DEFAULTS_LIMIT=20

# =============================================================================
# Browser Capture (Selkies) Configuration
# =============================================================================
# Browser capture (Selkies) UI feature flags
# Enable clipboard support between host and browser-capture session
SELKIES_CLIPBOARD_ENABLED=true
SELKIES_CLIPBOARD_BRIDGE_ENABLED=true
# Disable gaming controls in sidebar
SELKIES_GAMEPAD_ENABLED=false
SELKIES_UI_SIDEBAR_SHOW_GAMEPADS=false
SELKIES_UI_SIDEBAR_SHOW_GAMING_MODE=false
# Disable sharing and apps sections in sidebar
SELKIES_UI_SIDEBAR_SHOW_SHARING=false
SELKIES_UI_SIDEBAR_SHOW_APPS=false

# =============================================================================
# MCP first-party tool boundary
# =============================================================================
MCP_TRANSPORT=in_process
MCP_LOOPBACK_URL=http://127.0.0.1:8000/internal/mcp/
MCP_OTEL_ENABLED=false
MCP_REQUEST_TIMEOUT_SECONDS=600

# Agent runtime deployment
LANGGRAPH_RUNTIME_URL=http://langgraph-runtime:8100
LANGGRAPH_RUNTIME_TOKEN=replace-with-a-long-random-runtime-token

# The following variables belong only to langgraph-runtime, never rag-service.
ASKPDF_AGENT_CHECKPOINTER=postgres
AGENT_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@postgresql:5432/runtime_checkpoints
ASKPDF_AGENT_CHECKPOINTER_SETUP=true
AGENT_RUNTIME_EXECUTION_DATABASE_URL=postgresql://postgres:postgres@postgresql:5432/runtime_checkpoints
AGENT_RUNTIME_RECOVERY_LOOP_ENABLED=true
LANGGRAPH_RUNTIME_BINDING_SECRET=replace-with-a-distinct-long-binding-secret

# Set to hermes to build, start, and advertise the optional Hermes runtime.
COMPOSE_PROFILES=
HERMES_MODEL_CONTEXT_LENGTH=32768
# Provider identifier understood by the pinned Hermes runtime. LM Studio may
# use an explicitly configured window below Hermes's general 64K floor.
HERMES_MODEL_PROVIDER=lmstudio
# Required for Hermes providers other than lmstudio.
OPENAI_API_KEY=
LLM_AUTH_MODE=required
# Set LLM_AUTH_MODE=none only with an explicitly local provider.
LLM_KEYLESS_PROVIDER=
HERMES_MCP_CONTEXT_SECRET=replace-with-a-long-random-secret
HERMES_UPSTREAM_REVISION=bdd0a79c6a0ebc2344d5d6913c70bd89fa59c894
HERMES_RUNTIME_URL=http://hermes-runtime:8200
# Required. Use a strong random value; Compose fails closed when it is absent.
API_SERVER_KEY=
ASKPDF_MCP_URL=http://rag-service:8000/internal/mcp/
ASKPDF_MCP_HEALTH_URL=http://rag-service:8000/health
ASKPDF_MCP_REQUIRED=true
HERMES_RUNTIME_VERSION=hermes-gateway-1
HERMES_RUNTIME_WORKERS=1
HERMES_RUN_PROFILE_MAX_AGE_SECONDS=86400
HERMES_RUN_PROFILE_SWEEP_INTERVAL_SECONDS=3600
HERMES_RUNTIME_STATE_PATH=/var/lib/hermes/runtime-state.json
HERMES_RUNTIME_STORAGE_BACKEND=file
HERMES_RUNTIME_EVENT_ID_MODE=durable
HERMES_PROFILE_ROOT=/opt/data/profiles
HERMES_PROFILE_UID=10000
HERMES_PROFILE_GID=10000
AGENT_RUNTIME_LEASE_SECONDS=120
AGENT_RUNTIME_CONNECT_TIMEOUT_SECONDS=30
AGENT_RUNTIME_WRITE_TIMEOUT_SECONDS=300
AGENT_RUNTIME_READ_TIMEOUT_SECONDS=600
AGENT_RUNTIME_SHUTDOWN_GRACE_SECONDS=120
AGENT_RUNTIME_CANCEL_CONFIRM_TIMEOUT_SECONDS=120
AGENT_RUNTIME_TERMINAL_CONFIRM_TIMEOUT_SECONDS=120
AGENT_EVENT_POLL_INTERVAL_SECONDS=1
AGENT_SSE_HEARTBEAT_INTERVAL_SECONDS=12
AGENT_CANCELLATION_POLL_INTERVAL_SECONDS=0.5
NEXT_PUBLIC_AGENT_TASK_POLL_INTERVAL_MS=2000
NEXT_PUBLIC_AGENT_SSE_RECONNECT_INTERVAL_MS=2000
AGENT_RUNTIME_DEPENDENCY_REFRESH_SECONDS=30
AGENT_RUNTIME_DEPENDENCY_TIMEOUT_SECONDS=60
AGENT_RUNTIME_DEPENDENCY_STALE_SECONDS=180
AGENT_RUNTIME_DEPENDENCY_JITTER_RATIO=0.1
AGENT_RUNTIME_RECOVERY_INTERVAL_SECONDS=30
AGENT_RUNTIME_RECOVERY_BATCH_SIZE=100
# Shared budgets for every Deep Agent runtime.
DEEP_AGENT_MAX_MODEL_CALLS=10000
DEEP_AGENT_MAX_MODEL_TOKENS=500000
DEEP_AGENT_MAX_TOOL_CALLS=100
DEEP_AGENT_MAX_ACTIVE_RUNTIME_MS=7200000
DEEP_AGENT_MAX_DURATION_MS=7200000
DEEP_AGENT_MAX_OUTPUT_CHARS=50000
DEEP_AGENT_MAX_EVENT_COUNT=5000
DEEP_AGENT_WAKE_LIMIT_SECONDS=3600
DEEP_AGENT_SUBAGENT_TIMEOUT_MS=600000
DEEP_AGENT_DISPATCH_TIMEOUT_MS=600000
DEEP_AGENT_WORKER_TIMEOUT_MS=600000
DEEP_AGENT_WEB_WORKER_TIMEOUT_MS=600000
DEEP_AGENT_LANGGRAPH_MAX_MODEL_CALLS=${DEEP_AGENT_MAX_MODEL_CALLS}
DEEP_AGENT_LANGGRAPH_MAX_MODEL_TOKENS=${DEEP_AGENT_MAX_MODEL_TOKENS}
DEEP_AGENT_LANGGRAPH_MAX_TOOL_CALLS=${DEEP_AGENT_MAX_TOOL_CALLS}
DEEP_AGENT_LANGGRAPH_MAX_ACTIVE_RUNTIME_MS=${DEEP_AGENT_MAX_ACTIVE_RUNTIME_MS}
DEEP_AGENT_LANGGRAPH_MAX_DURATION_MS=${DEEP_AGENT_MAX_DURATION_MS}
DEEP_AGENT_LANGGRAPH_MAX_OUTPUT_CHARS=${DEEP_AGENT_MAX_OUTPUT_CHARS}
DEEP_AGENT_LANGGRAPH_MAX_EVENT_COUNT=${DEEP_AGENT_MAX_EVENT_COUNT}
DEEP_AGENT_LANGGRAPH_WAKE_LIMIT_SECONDS=${DEEP_AGENT_WAKE_LIMIT_SECONDS}
DEEP_AGENT_LANGGRAPH_SUBAGENT_TIMEOUT_MS=${DEEP_AGENT_SUBAGENT_TIMEOUT_MS}
DEEP_AGENT_LANGGRAPH_DISPATCH_TIMEOUT_MS=${DEEP_AGENT_DISPATCH_TIMEOUT_MS}
DEEP_AGENT_LANGGRAPH_WORKER_TIMEOUT_MS=${DEEP_AGENT_WORKER_TIMEOUT_MS}
DEEP_AGENT_LANGGRAPH_WEB_WORKER_TIMEOUT_MS=${DEEP_AGENT_WEB_WORKER_TIMEOUT_MS}
DEEP_AGENT_HERMES_MAX_MODEL_CALLS=${DEEP_AGENT_MAX_MODEL_CALLS}
DEEP_AGENT_HERMES_MAX_MODEL_TOKENS=${DEEP_AGENT_MAX_MODEL_TOKENS}
DEEP_AGENT_HERMES_MAX_TOOL_CALLS=${DEEP_AGENT_MAX_TOOL_CALLS}
DEEP_AGENT_HERMES_MAX_ACTIVE_RUNTIME_MS=${DEEP_AGENT_MAX_ACTIVE_RUNTIME_MS}
DEEP_AGENT_HERMES_MAX_DURATION_MS=${DEEP_AGENT_MAX_DURATION_MS}
DEEP_AGENT_HERMES_MAX_OUTPUT_CHARS=${DEEP_AGENT_MAX_OUTPUT_CHARS}
DEEP_AGENT_HERMES_MAX_EVENT_COUNT=${DEEP_AGENT_MAX_EVENT_COUNT}
DEEP_AGENT_HERMES_WAKE_LIMIT_SECONDS=${DEEP_AGENT_WAKE_LIMIT_SECONDS}
AGENT_RUNTIME_RECONNECT_MAX_ATTEMPTS=10
AGENT_RUNTIME_RECONNECT_BACKOFF_SECONDS=1
AGENT_RUNTIME_RECONNECT_DEADLINE_SECONDS=600
AGENT_RUNTIME_OUTPUT_DELTA_FLUSH_SECONDS=0.5
AGENT_RUNTIME_OUTPUT_DELTA_FLUSH_BYTES=8192
