# syntax=docker/dockerfile:1
# Overlay on the pinned upstream Hermes image: bake askPDF's gateway patch into
# the sealed venv via site-packages .pth so v0.23 launchers that unset
# PYTHONPATH still import sitecustomize at gateway startup.
FROM hermes-upstream

ARG ASKPDF_HERMES_PATCH_ROOT=/opt/askpdf-hermes-pinned-patch
COPY hermes_runtime/hermes_pinned_patch ${ASKPDF_HERMES_PATCH_ROOT}

RUN ["/opt/hermes/.venv/bin/python", "-c", "import pathlib, site; root = pathlib.Path('/opt/askpdf-hermes-pinned-patch'); assert (root / 'sitecustomize.py').is_file(), root; site_dir = next(p for p in site.getsitepackages() if p.endswith('site-packages')); pth = pathlib.Path(site_dir) / 'askpdf-hermes-pinned.pth'; pth.write_text(f\"{root}\\n\", encoding='utf-8'); assert pth.is_file(), pth"]
