# syntax=docker/dockerfile:1
# Overlay on the pinned upstream Hermes image: bake askPDF's gateway patch into
# the sealed venv via site-packages .pth so v0.23 launchers that unset
# PYTHONPATH still import sitecustomize and runtime_protocol at gateway startup.
FROM hermes-upstream

ARG ASKPDF_HERMES_PATCH_ROOT=/opt/askpdf-hermes-pinned-patch
ARG ASKPDF_PYLIB_ROOT=/opt/askpdf-pylib
COPY hermes_runtime/hermes_pinned_patch ${ASKPDF_HERMES_PATCH_ROOT}
COPY runtime_protocol ${ASKPDF_PYLIB_ROOT}/runtime_protocol

RUN ["/opt/hermes/.venv/bin/python", "-c", "import importlib.util, pathlib, site; patch_root = pathlib.Path('/opt/askpdf-hermes-pinned-patch'); pylib_root = pathlib.Path('/opt/askpdf-pylib'); schema_path = pylib_root / 'runtime_protocol' / 'provider_tool_schema.py'; assert (patch_root / 'sitecustomize.py').is_file(); assert schema_path.is_file(); site_dir = next(p for p in site.getsitepackages() if p.endswith('site-packages')); pth = pathlib.Path(site_dir) / 'askpdf-hermes-pinned.pth'; text = f'{patch_root}\\n{pylib_root}\\n'; pth.write_text(text, encoding='utf-8'); assert pth.read_text(encoding='utf-8') == text; spec = importlib.util.spec_from_file_location('askpdf_provider_tool_schema', schema_path); module = importlib.util.module_from_spec(spec); assert spec and spec.loader; spec.loader.exec_module(module); assert callable(module.provider_compatible_function_tools)"]
