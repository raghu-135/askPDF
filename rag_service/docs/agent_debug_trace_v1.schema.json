{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askpdf.local/schemas/agent_debug_trace_v1.schema.json",
  "title": "askPDF Agent Debug Trace v1",
  "description": "Normalized trace document stored inside debug.trace by GET /api/agent-runs/{id}. Span-level raw payloads preserve the original runtime event for the selected span.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "trace_id",
    "run_id",
    "template_id",
    "status",
    "attributes",
    "metrics",
    "spans",
    "links",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string"
    },
    "run_id": {
      "type": ["string", "number"]
    },
    "thread_id": {
      "type": ["string", "number", "null"]
    },
    "chat_turn_id": {
      "type": ["string", "number", "null"]
    },
    "user_id": {
      "type": ["string", "number", "null"]
    },
    "template_id": {
      "type": ["string", "null"]
    },
    "template_version_id": {
      "type": ["string", "null"]
    },
    "pattern_type": {
      "type": ["string", "null"]
    },
    "status": {
      "type": ["string", "null"]
    },
    "started_at": {
      "type": ["string", "null"]
    },
    "completed_at": {
      "type": ["string", "null"]
    },
    "duration_ms": {
      "type": ["number", "null"]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "llm_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "llm_token_count_prompt": {
          "type": "integer",
          "minimum": 0
        },
        "llm_token_count_completion": {
          "type": "integer",
          "minimum": 0
        },
        "llm_token_count_total": {
          "type": "integer",
          "minimum": 0
        },
        "llm_token_count_reasoning": {
          "type": "integer",
          "minimum": 0
        },
        "llm_token_count_cached": {
          "type": "integer",
          "minimum": 0
        },
        "llm_retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "span_id",
        "parent_span_id",
        "name",
        "kind",
        "status",
        "attributes",
        "input",
        "output",
        "events",
        "links",
        "raw"
      ],
      "properties": {
        "span_id": {
          "type": "string"
        },
        "parent_span_id": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": ["AGENT", "CHAIN", "LLM", "RETRIEVER", "TOOL", "PROMPT"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "start_time": {
          "type": ["string", "null"]
        },
        "end_time": {
          "type": ["string", "null"]
        },
        "duration_ms": {
          "type": ["number", "null"]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "output": {
          "type": "object",
          "additionalProperties": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "examples": [
                  "decision.made",
                  "tool.called",
                  "checkpoint.created",
                  "interrupt.requested",
                  "resume.requested",
                  "resume.applied",
                  "graph.resumed",
                  "interrupt.resumed",
                  "interrupt.rejected",
                  "interrupt.expired"
                ]
              },
              "attributes": {
                "type": "object",
                "additionalProperties": true
              },
              "input": {
                "type": "object",
                "additionalProperties": true
              },
              "output": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "raw": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
