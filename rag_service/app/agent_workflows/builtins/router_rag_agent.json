        "edges": [
          {
            "from": "START",
            "to": "context_loader"
          },
          {
            "from": "context_loader",
            "to": "router"
          },
          {
            "conditional": true,
            "from": "router",
            "route_fn": "router_route",
            "routes": {
              "clarify": "finalizer",
              "direct": "direct_answer",
              "document": "retrieval_worker",
              "durable_memory": "durable_memory_worker",
              "thread_conversation_history": "thread_conversation_history_worker",
              "thread_events": "thread_events_worker",
              "web": "web_worker"
            }
          },
          {
            "from": "retrieval_worker",
            "to": "synthesizer"
          },
          {
            "from": "thread_conversation_history_worker",
            "to": "synthesizer"
          },
          {
            "from": "durable_memory_worker",
            "to": "synthesizer"
          },
          {
            "from": "thread_events_worker",
            "to": "synthesizer"
          },
          {
            "from": "web_worker",
            "to": "synthesizer"
          },
          {
            "from": "direct_answer",
            "to": "finalizer"
          },
          {
            "from": "synthesizer",
            "to": "finalizer"
          },
          {
            "from": "finalizer",
            "to": "END"
          }
        ],
        "nodes": [
          {
            "id": "context_loader",
            "type": "context_loader"
          },
          {
            "id": "router",
            "type": "router"
          },
          {
            "id": "retrieval_worker",
            "type": "retrieval_worker"
          },
          {
            "id": "thread_conversation_history_worker",
            "type": "thread_conversation_history_worker"
          },
          {
            "id": "durable_memory_worker",
            "type": "durable_memory_worker"
          },
          {
            "id": "thread_events_worker",
            "type": "thread_events_worker"
          },
          {
            "id": "web_worker",
            "type": "web_worker"
          },
          {
            "id": "direct_answer",
            "type": "direct_answer"
          },
          {
            "id": "synthesizer",
            "type": "synthesizer"
          },
          {
            "id": "finalizer",
            "type": "finalizer"
          }
        ]
      },
      "hitl_policy": {
        "enabled": false,
        "gates": {}
      },
      "loop_policy": {
        "default_max_node_visits": 1,
        "max_total_visits": 10,
        "node_visit_limits": {
          "durable_memory_worker": 2,
          "thread_conversation_history_worker": 2,
          "retrieval_worker": 2,
          "thread_events_worker": 2,
          "web_worker": 2
        }
      },
      "prefetch_policy": {
        "enabled": true
      },
      "system_role": "",
      "tool_instructions": {},
