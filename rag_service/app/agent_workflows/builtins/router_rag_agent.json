{
  "builtin_key": "router_rag_agent",
  "description": "A compiled LangGraph workflow that loads context, routes to document retrieval, thread conversation history, durable memory, thread events, direct answer, or clarification, then synthesizes a final response.",
  "is_builtin": true,
  "name": "Router RAG Agent",
  "spec_json": {
    "config": {
      "allowed_tool_ids": [
        "document_evidence",
        "thread_conversation_history",
        "durable_memory",
        "thread_events",
        "live_web_recon",
        "clarify_intent"
      ],
      "context_policy": {
        "evidence_compression": "compact",
        "evidence_dedupe": true,
        "evidence_packet_content_limit": 2000,
        "evidence_packet_limit": 12,
        "final_context_char_limit": 25536,
        "final_prompt_assembly": "evidence_packets"
      },
      "custom_instructions": "",
