{
  "builtin_key": "evaluator_replanner_rag_agent",
  "description": "A bounded compiled RAG workflow that plans retrieval, evaluates evidence sufficiency, optionally replans once, then synthesizes a final response.",
  "is_builtin": true,
  "name": "Evaluator/Replanner RAG Agent",
  "spec_json": {
    "config": {
      "allowed_tool_ids": [
        "document_evidence",
        "thread_conversation_history",
        "thread_events",
        "live_web_recon",
        "clarify_intent"
      ],
      "context_policy": {
        "evidence_compression": "compact",
        "evidence_dedupe": true,
        "evidence_packet_content_limit": 2000,
        "evidence_packet_limit": 12,
        "final_context_char_limit": 25536,
        "final_prompt_assembly": "evidence_packets"
      },
      "custom_instructions": "",
      "graph": {
        "edges": [
          {
            "from": "START",
            "to": "context_loader"
          },
          {
            "from": "context_loader",
            "to": "planner"
          },
          {
            "conditional": true,
            "from": "planner",
            "route_fn": "planner_route",
            "routes": {
              "clarify": "finalizer",
              "direct": "direct_answer",
              "execute": "retrieval_worker"
            }
          },
          {
            "from": "direct_answer",
            "to": "finalizer"
          },
          {
            "from": "retrieval_worker",
            "to": "thread_conversation_history_worker"
          },
          {
            "from": "thread_conversation_history_worker",
            "to": "thread_events_worker"
          },
          {
            "from": "thread_events_worker",
            "to": "web_worker"
          },
          {
            "from": "web_worker",
            "to": "evidence_evaluator"
          },
          {
            "conditional": true,
            "from": "evidence_evaluator",
            "route_fn": "evaluator_route",
            "routes": {
              "answer": "synthesizer",
              "answer_budget_exhausted": "synthesizer",
              "replan": "replanner"
            }
          },
          {
            "from": "replanner",
            "to": "retrieval_worker"
          },
          {
            "from": "synthesizer",
            "to": "finalizer"
          },
          {
            "from": "finalizer",
            "to": "END"
          }
        ],
        "nodes": [
          {
            "id": "context_loader",
            "type": "context_loader"
          },
          {
            "id": "planner",
            "type": "planner"
          },
          {
            "id": "direct_answer",
            "type": "direct_answer"
          },
          {
            "id": "retrieval_worker",
            "type": "retrieval_worker"
          },
          {
            "id": "thread_conversation_history_worker",
            "type": "thread_conversation_history_worker"
          },
          {
            "id": "thread_events_worker",
            "type": "thread_events_worker"
          },
          {
            "id": "web_worker",
            "type": "web_worker"
          },
          {
            "id": "evidence_evaluator",
            "type": "evidence_evaluator"
          },
          {
            "id": "replanner",
            "type": "replanner"
          },
          {
            "id": "synthesizer",
            "type": "synthesizer"
          },
          {
            "id": "finalizer",
            "type": "finalizer"
          }
        ]
      },
      "hitl_policy": {
        "enabled": false,
        "gates": {}
      },
      "loop_policy": {
        "default_max_node_visits": 1,
        "max_total_visits": 16,
        "node_visit_limits": {
          "evidence_evaluator": 2,
          "thread_conversation_history_worker": 2,
          "replanner": 1,
          "retrieval_worker": 2,
          "thread_events_worker": 2,
          "web_worker": 2
        }
      },
      "prefetch_policy": {
        "enabled": true
      },
      "replans": 1,
      "system_role": "",
      "tool_instructions": {},
      "use_reranker": true,
      "use_web_search": false
    },
    "workflow_id": "evaluator_replanner_rag_agent",
    "runtime": {
      "failure_code": "evaluator_replanner_rag_execution_failed",
      "failure_context": "Compiled Evaluator/Replanner RAG Agent execution failed gracefully.",
      "failure_reason_prefix": "Exception during Evaluator/Replanner RAG execution",
      "features": {
        "supports_replans": true
      },
      "kind": "compiled_rag",
      "label": "Evaluator/Replanner RAG",
      "prompt_preview": "evaluator_replanner",
      "success_context": "Context retrieved by compiled Evaluator/Replanner RAG Agent workflow."
    },
    "schema_version": 2,
    "version": 3
  },
  "visibility": "builtin"
}
