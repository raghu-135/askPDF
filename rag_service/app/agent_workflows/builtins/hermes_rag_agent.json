{
  "builtin_key": "hermes_rag_agent",
  "description": "An opt-in durable Deep Research engine backed by the pinned Hermes runtime.",
  "is_builtin": true,
  "visibility": "builtin",
  "name": "Hermes RAG Agent",
  "framework": "hermes",
  "builder_id": "hermes_agent",
  "category": "deep",
  "spec_json": {
    "schema_version": 2,
    "definition_version": 2,
    "version": 2,
    "runtime": {"kind": "hermes_agent", "features": {"supports_replans": false, "supports_long_running_tasks": true, "supports_artifacts": true}},
    "config": {
      "system_prompt": "Perform the requested research task using askPDF MCP evidence. When the user says this paper, the paper, or according to the context, first call get_thread_shape, then call search_document_by_id when a file hash is known or search_documents otherwise. Search conversation history when recent context does not resolve the reference. Cite the evidence used. Never claim that a document or context is unavailable until an authorized retrieval tool has returned an applicable empty or error result.",
      "model": "",
      "mcp_server": "askpdf",
      "allowed_tool_ids": ["get_thread_shape", "search_documents", "search_document_by_id", "search_thread_conversation_history", "search_thread_events", "search_durable_memory", "search_web", "wikipedia", "wikidata", "arxiv", "pubmed", "semantic_scholar", "stack_exchange", "yahoo_finance_news"],
      "max_output_chars": 12000,
      "max_duration_seconds": 300,
      "max_event_count": 200,
      "allow_subagents": true,
      "allow_persistent_memory": false,
      "skills": [],
      "cancellation_mode": "upstream_stop",
      "task_policy": {
        "builtin_only": true,
        "evidence": "document_when_available",
        "profiles": ["document_researcher", "memory_researcher", "evidence_critic"],
        "limits": {
          "max_todos": 50,
          "max_plan_revisions": 8,
          "max_replans": 5,
          "max_concurrency": 2,
          "max_fanout": 2,
          "max_attempts_per_todo": 2,
          "subagent_timeout_ms": 180000,
          "max_active_runtime_ms": 3600000,
          "max_tool_calls": 100,
          "max_model_tokens": 500000,
          "max_artifacts": 200,
          "max_artifact_bytes": 104857600,
          "max_single_artifact_bytes": 10485760
        }
      }
    }
  }
}
